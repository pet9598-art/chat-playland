rules_version = '2';

// 채팅 놀이터 (chat-playland) Firestore 보안 규칙
// - 교실 환경(선생님이 지켜보는 익명 인증 학생들)을 전제로 한 "신뢰 기반" 규칙입니다.
// - 단, 단어 마피아의 비밀 단어/역할(secrets)만큼은 "본인 또는 방장"만 읽을 수 있도록
//   문서 단위로 엄격히 제한합니다. 이 부분이 이 앱에서 가장 중요한 보안 규칙입니다.
//
// 적용 방법: Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 내용을 붙여넣고 게시(Publish)하세요.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isHost(roomId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == request.auth.uid;
    }

    match /rooms/{roomId} {
      // 방 목록/상태는 익명 인증한 누구나 조회 가능 (로비 목록 표시용)
      allow read: if isSignedIn();

      // 방 생성: 본인을 hostUid로 지정해야 함
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;

      // 방 상태/게임 진행 정보 갱신: 참가자 누구나 (교실 신뢰 기반)
      allow update: if isSignedIn();

      // 방 삭제: 방장이거나, 마지막 인원이 나가는 경우(playerCount<=1)
      allow delete: if isSignedIn() &&
        (isHost(roomId) || (resource.data.playerCount is number && resource.data.playerCount <= 1));

      match /players/{uid} {
        allow read: if isSignedIn();
        // 본인 문서만 생성/수정 가능. 단, 방장은 게임 진행을 위해(탈락 처리 등) 다른 플레이어 문서도 수정 가능
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update: if isSignedIn() && (request.auth.uid == uid || isHost(roomId));
        // 방 정리(cascade delete) 시 누구나(방치된 다른 사람 문서 포함) 지울 수 있어야
        // "방이 없어지면 데이터도 삭제" 요구사항을 지킬 수 있음
        allow delete: if isSignedIn();
      }

      match /messages/{msgId} {
        allow read: if isSignedIn();
        // 일반 채팅 메시지는 본인 uid로만, 시스템 메시지(uid 없음)는 누구나 기록 가능
        allow create: if isSignedIn() &&
          (request.resource.data.uid == request.auth.uid || request.resource.data.system == true);
        allow update: if false;
        // 방 정리(cascade delete) 시 누구나(방장이 아니어도) 메시지를 지울 수 있어야
        // "방이 없어지면 채팅 데이터도 삭제" 요구사항을 지킬 수 있음
        allow delete: if isSignedIn();
      }

      // 단어 마피아 비밀 정보: 본인 또는 방장만 읽을 수 있음 (핵심 보안 규칙)
      match /secrets/{uid} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isHost(roomId));
        allow create, update: if isHost(roomId);
        // 방 정리(cascade delete) 시 누구나 지울 수 있어야 함
        allow delete: if isSignedIn();
      }
    }
  }
}
